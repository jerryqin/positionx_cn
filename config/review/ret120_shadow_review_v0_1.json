    "HUMAN_LIVE": {
      "entry_rule": "APPROVE fill from human decision ledger",
      "subsequent_trades": "human_trade_ledger ADD/REDUCE/EXIT",
      "accounting": "weighted_average_cost_long_only",
      "exit_policy": "HUMAN_ACTUAL"
