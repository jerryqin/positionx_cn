    "append_only_hash_chain": true,
    "fees_optional": true,
    "initial_entry_fees_source": "human_decision_ledger.human_fill_fees",
    "pnl_fee_semantics": "All recorded ENTRY/ADD/REDUCE/EXIT fees are deducted from HUMAN_LIVE net P&L exactly once.",
    "prevalidate_before_append": true,
    "event_order": "trade_date/event_date then recorded_at"
